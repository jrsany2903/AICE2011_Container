<!-- models/line/model.sdf -->
<?xml version ="1.0 "?>
<sdf version="1.10">
    <model name="line">
        <static>true</static>

        <link name="link">
            <visual name="green_line">
                <geometry>
                    <box>
                        <size>2.0 0.02 0.001</size>
                    </box>
                </geometry>

                <material>
                    <ambient>0.0 0.8 0.0 1</ambient>
                    <diffuse>0.0 1.0 0.0 1</diffuse>
                    <specular>0.0 0.0 0.0 1</specular>
                </material>
            </visual>

            <collision name="collision">
                <geometry>
                    <box>
                        <size>2.0 0.02 0.001</size>
                    </box>
                </geometry>
            </collision>
        </link>
    </model>
</sdf>
